<?xml version="1.0" encoding="utf-8"?>
<!-- BONUS « bottom-up » : seul l'interrupteur est passé en Compose, via une ComposeView -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unite_temperature"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <RadioGroup
        android:id="@+id/groupeUnite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/radioCelsius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/celsius" />
        <RadioButton
            android:id="@+id/radioFahrenheit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fahrenheit" />
    </RadioGroup>

    <!-- Remplace le MaterialSwitch : le contenu est fourni par setContent { } dans l'Activity -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeThemeSombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
