<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions « dangereuses » : déclarées ici, ET demandées à l'exécution (étape 1).
         Les deux ensemble : depuis Android 12, l'utilisateur peut choisir « approximative ». -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeolocSujets">

        <!-- Décommenter l'étape à exécuter, et laisser les autres en commentaire. -->

        <!-- Étape 0 : Permissions déclarées et vérifiées -->
        <activity android:name=".sujet0.MainActivity0" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

